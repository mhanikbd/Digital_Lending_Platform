# Copy to .env before starting the stack:  cp .env.example .env
# These are development credentials for a local machine only. Never reuse them
# in a shared, staging or production environment.

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=digital_lending
POSTGRES_USER=dlp_owner
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change_me_locally
REDIS_PORT=6379

# ---- MinIO / object storage -------------------------------------------------
MINIO_ROOT_USER=dlp_minio_local
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BUCKET=dlp-documents

# ---- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_LOG_LEVEL=DEBUG
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# ---- Bank portal ------------------------------------------------------------
PORTAL_PORT=3000
PORTAL_ORIGIN=http://localhost:3000

# ---- Optional profiles ------------------------------------------------------
GATEWAY_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_locally
