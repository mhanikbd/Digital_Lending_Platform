root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,sql}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,sh}]
indent_size = 4
